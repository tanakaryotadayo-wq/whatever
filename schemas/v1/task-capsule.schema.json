{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akashic.task-capsule/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "context_id", "logical_attempt_id", "goal", "acceptance"],
  "properties": {
    "schema": {"const": "akashic.task-capsule/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "context_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "logical_attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "goal": {"type": "string", "minLength": 1, "maxLength": 16000},
    "acceptance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "context_refs": {"type": "array", "items": {"$ref": "akashic.artifact-ref/v1"}},
    "execution_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
