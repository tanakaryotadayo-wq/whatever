{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akashic.agent-provenance/v1",
  "title": "AgentProvenanceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provenance_id", "subject_digests", "source", "run", "agent", "context_inputs", "outputs", "policy_ref", "sandbox", "evidence_refs", "started_at", "completed_at"],
  "properties": {
    "schema": {"const": "akashic.agent-provenance/v1"},
    "provenance_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "subject_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit", "tree"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}, "tree": {"type": ["string", "null"]}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "context_id", "logical_attempt_id"],
      "properties": {"task_id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1}, "logical_attempt_id": {"type": "string", "minLength": 1}, "turn_no": {"type": "integer", "minimum": 1}}
    },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["provider", "adapter_version", "model", "session_capability"],
      "properties": {"provider": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "model": {"type": ["string", "null"]}, "session_capability": {"type": ["string", "null"]}}
    },
    "context_inputs": {"type": "array", "items": {"$ref": "akashic.artifact-ref/v1"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "akashic.artifact-ref/v1"}},
    "policy_ref": {"oneOf": [{"$ref": "akashic.artifact-ref/v1"}, {"type": "null"}]},
    "sandbox": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array", "items": {"$ref": "akashic.artifact-ref/v1"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
