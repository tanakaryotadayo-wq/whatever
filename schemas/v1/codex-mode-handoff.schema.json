{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/codex-mode-handoff.schema.json",
  "title": "Akashic Codex Mode Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode_id",
    "mode_version",
    "handoff_id",
    "created_at",
    "workstream_id",
    "projection",
    "current_role",
    "source_snapshot",
    "work_packet",
    "attempt_ledger",
    "next_action",
    "executor_return_contract",
    "verification",
    "evidence_refs"
  ],
  "properties": {
    "schema": {"const": "akashic.codex-mode-handoff/v1"},
    "mode_id": {"const": "codex-mode"},
    "mode_version": {"type": "string"},
    "handoff_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "workstream_id": {"type": "string", "minLength": 1},
    "projection": {"enum": ["DRAFT", "ACTIVE", "BLOCKED", "READY", "DONE", "FAILED", "ARCHIVED"]},
    "current_role": {"enum": ["SUPERVISOR", "EXECUTOR", "VERIFIER"]},
    "source_snapshot": {
      "type": "object",
      "required": ["repository", "reconciled_against_main_head", "provider_branch", "provider_head", "provider_pull_request"]
    },
    "work_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "scope",
        "definition_of_done",
        "out_of_scope",
        "authority",
        "expected_heads",
        "allowed_paths",
        "protected_paths",
        "evidence_required",
        "do_not_repeat_without_change"
      ],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "authority": {"type": "object"},
        "expected_heads": {"type": "object"},
        "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "protected_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "do_not_repeat_without_change": {"type": "array", "items": {"type": "string"}}
      }
    },
    "attempt_ledger": {
      "type": "array",
      "items": {"type": "object", "required": ["attempt_id", "status", "resume_condition"]}
    },
    "next_action": {"type": "object", "required": ["action_id", "role", "assistant_executable_now", "instruction"]},
    "executor_return_contract": {"type": "object", "required": ["required"]},
    "verification": {"type": "object", "required": ["verdict", "reason", "adoption_allowed"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
