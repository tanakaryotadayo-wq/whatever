{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/eval-case.schema.json",
  "title": "AkashicEvalCaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "capability", "status", "input", "expected", "source_refs", "tags", "created_at"],
  "properties": {
    "schema": {"const": "akashic.eval-case/v1"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "capability": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {"enum": ["CANDIDATE", "ACCEPTED", "RETIRED"]},
    "input": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["exact", "subset", "error_code", "ordered_values"]},
        "path": {"type": "string"},
        "value": {},
        "code": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1}
      }
    },
    "source_refs": {"type": "array", "items": {"$ref": "https://akashic.dev/schemas/v1/artifact-ref.schema.json"}},
    "verification_ref": {"$ref": "https://akashic.dev/schemas/v1/artifact-ref.schema.json"},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "accepted_by": {"type": "string", "minLength": 1},
    "case_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
