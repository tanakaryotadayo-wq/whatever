{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/codex-mode-state.schema.json",
  "title": "Akashic Codex Mode State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode_id",
    "mode_version",
    "activation_phrase",
    "observed_at",
    "freshness_ttl_seconds",
    "phase",
    "status",
    "certification",
    "task_projection",
    "default_operation_mode",
    "authorities",
    "source",
    "drive",
    "provider_attempts",
    "capabilities",
    "blockers",
    "commands",
    "read_layers",
    "next_actions",
    "status_card"
  ],
  "properties": {
    "schema": {"const": "akashic.codex-mode-state/v1"},
    "mode_id": {"const": "codex-mode"},
    "mode_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "activation_phrase": {"const": "codexモード起動"},
    "observed_at": {"type": "string", "format": "date-time"},
    "freshness_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "phase": {"type": "string", "minLength": 1},
    "status": {"enum": [
      "CERTIFIED",
      "PROVIDER_ATTEMPTED_FAILED_AND_BLOCKED",
      "PROVIDER_ATTEMPT_FAILED",
      "PROVIDER_ATTEMPT_BLOCKED",
      "FIXTURE_PASS_LIVE_OPEN",
      "SOURCE_BLOCKED",
      "TOOLING_UNAVAILABLE",
      "STALE"
    ]},
    "certification": {"enum": ["OPEN", "CERTIFIED", "REVOKED"]},
    "task_projection": {"enum": ["DRAFT", "ACTIVE", "BLOCKED", "READY", "DONE", "FAILED", "ARCHIVED"]},
    "default_operation_mode": {"enum": ["PLAN", "EXECUTE_WHEN_SAFE"]},
    "authorities": {"type": "object", "minProperties": 4},
    "source": {
      "type": "object",
      "required": [
        "repository",
        "default_branch",
        "observed_main_head",
        "canonical_spec_path",
        "state_path",
        "provider_branch",
        "observed_provider_head",
        "provider_pull_request"
      ],
      "properties": {
        "repository": {"type": "string"},
        "default_branch": {"type": "string"},
        "observed_main_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "canonical_spec_path": {"const": "docs/modes/CODEX_MODE.md"},
        "state_path": {"const": "docs/modes/CODEX_MODE_STATE.json"},
        "provider_branch": {"type": "string"},
        "observed_provider_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "provider_pull_request": {
          "type": "object",
          "required": ["number", "state", "draft"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "state": {"enum": ["OPEN", "CLOSED", "MERGED"]},
            "draft": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "superseded_provider_branch": {"type": "string"}
      },
      "additionalProperties": false
    },
    "drive": {"type": "object", "minProperties": 5},
    "provider_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt_id", "status", "official_codex_binary", "evidence_path", "source_commit"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAILED", "BLOCKED", "NO_RESULT"]},
          "official_codex_binary": {"type": "boolean"},
          "reason": {"type": "string"},
          "evidence_path": {"type": "string"},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
        },
        "additionalProperties": true
      }
    },
    "capabilities": {"type": "object"},
    "blockers": {"type": "array"},
    "commands": {"type": "array", "minItems": 7},
    "read_layers": {"type": "object", "required": ["L0", "L1", "L2", "L3"]},
    "next_actions": {"type": "array", "minItems": 1},
    "status_card": {"type": "object", "required": ["blocker", "next", "evidence"]}
  }
}
