{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/codex-mode-state.schema.json",
  "title": "Akashic Codex Mode State v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mode_id", "mode_version", "activation_phrase", "observed_at",
    "freshness_ttl_seconds", "phase", "status", "certification", "task_projection",
    "current_role", "default_operation_mode", "authorities", "integrity", "source",
    "drive", "provider_attempts", "capabilities", "roles", "blockers", "commands",
    "read_layers", "next_actions", "status_card"
  ],
  "properties": {
    "schema": {"const": "akashic.codex-mode-state/v1.1"},
    "mode_id": {"const": "codex-mode"},
    "mode_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "activation_phrase": {"const": "codexモード起動"},
    "observed_at": {"type": "string", "format": "date-time"},
    "freshness_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "phase": {"type": "string", "minLength": 1},
    "status": {"enum": [
      "CERTIFIED", "PROVIDER_ATTEMPTED_FAILED_AND_BLOCKED", "PROVIDER_ATTEMPT_FAILED",
      "PROVIDER_ATTEMPT_BLOCKED", "FIXTURE_PASS_LIVE_OPEN", "SOURCE_BLOCKED",
      "TOOLING_UNAVAILABLE", "STALE"
    ]},
    "certification": {"enum": ["OPEN", "CERTIFIED", "REVOKED"]},
    "task_projection": {"enum": ["DRAFT", "ACTIVE", "BLOCKED", "READY", "DONE", "FAILED", "ARCHIVED"]},
    "current_role": {"enum": ["SUPERVISOR", "EXECUTOR", "VERIFIER"]},
    "default_operation_mode": {"enum": ["PLAN", "EXECUTE_WHEN_SAFE"]},
    "authorities": {"type": "object", "minProperties": 4},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_semantics", "main_head_comparison", "manifest_path", "handoff_path", "audit_path"],
      "properties": {
        "state_semantics": {"const": "SNAPSHOT"},
        "main_head_comparison": {"const": "ANCESTOR_OR_EQUAL"},
        "manifest_path": {"const": "docs/modes/MANIFEST_CODEX_MODE_20260816.json"},
        "handoff_path": {"const": "docs/modes/CODEX_MODE_HANDOFF.json"},
        "audit_path": {"const": "docs/AUDIT-2026-08-16.json"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "default_branch", "reconciled_against_main_head", "main_head_relation",
        "canonical_spec_path", "state_path", "handoff_path", "provider_branch",
        "observed_provider_head", "provider_head_semantics", "provider_pull_request"
      ],
      "properties": {
        "repository": {"type": "string"},
        "default_branch": {"type": "string"},
        "reconciled_against_main_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "main_head_relation": {"const": "ANCESTOR_OR_EQUAL"},
        "canonical_spec_path": {"const": "docs/modes/CODEX_MODE.md"},
        "state_path": {"const": "docs/modes/CODEX_MODE_STATE.json"},
        "handoff_path": {"const": "docs/modes/CODEX_MODE_HANDOFF.json"},
        "provider_branch": {"type": "string"},
        "observed_provider_head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "provider_head_semantics": {"const": "EXACT_AT_OBSERVED_AT"},
        "provider_pull_request": {
          "type": "object",
          "required": ["number", "state", "draft"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "state": {"enum": ["OPEN", "CLOSED", "MERGED"]},
            "draft": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "last_ux_merge": {"type": "object"},
        "superseded_provider_branch": {"type": "string"}
      }
    },
    "drive": {"type": "object", "minProperties": 6},
    "provider_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt_id", "status", "official_codex_binary", "evidence_path", "source_commit"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAILED", "BLOCKED", "NO_RESULT"]},
          "official_codex_binary": {"type": "boolean"},
          "reason": {"type": "string"},
          "evidence_path": {"type": "string"},
          "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "do_not_repeat_without_change": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "capabilities": {"type": "object"},
    "roles": {
      "type": "object",
      "required": ["SUPERVISOR", "EXECUTOR", "VERIFIER"],
      "properties": {
        "SUPERVISOR": {"type": "string", "minLength": 1},
        "EXECUTOR": {"type": "string", "minLength": 1},
        "VERIFIER": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array"},
    "commands": {"type": "array", "minItems": 8},
    "read_layers": {"type": "object", "required": ["L0", "L1", "L1_5", "L2", "L3"]},
    "next_actions": {"type": "array", "minItems": 1},
    "status_card": {"type": "object", "required": ["blocker", "next", "evidence"]}
  }
}
