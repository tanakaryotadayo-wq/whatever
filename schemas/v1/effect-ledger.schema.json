{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/effect-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "effect_key", "task_id", "logical_attempt_id", "expected_generation", "candidate_artifact_ref", "verification_report_ref", "adoption_ref"],
  "properties": {
    "schema": {"const": "akashic.effect-ledger/v1"},
    "effect_key": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "logical_attempt_id": {"type": "string"},
    "expected_generation": {"type": "integer", "minimum": 0},
    "candidate_artifact_ref": {"$ref": "https://akashic.dev/schemas/v1/artifact-ref.schema.json"},
    "verification_report_ref": {"$ref": "https://akashic.dev/schemas/v1/artifact-ref.schema.json"},
    "adoption_ref": {"$ref": "https://akashic.dev/schemas/v1/artifact-ref.schema.json"}
  }
}
