{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/knowledge-packet-registry.schema.json",
  "title": "KnowledgePacketRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "source", "base", "target_branch", "packets"],
  "properties": {
    "schema": {"const": "akashic.knowledge-packet-registry/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "additionalProperties": false, "required": ["library_file_id", "name", "sha256", "packet_count"], "properties": {"library_file_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "packet_count": {"const": 30}}},
    "base": {"type": "object", "additionalProperties": false, "required": ["repository", "branch", "commit"], "properties": {"repository": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "target_branch": {"type": "string", "minLength": 1},
    "packets": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["packet_id", "adoption_status", "target_paths"], "properties": {"packet_id": {"type": "string", "pattern": "^KPK-[0-9]{3}$"}, "adoption_status": {"type": "string", "minLength": 1}, "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
  }
}
