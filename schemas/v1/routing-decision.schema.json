{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/routing-decision.schema.json",
  "title": "RoutingDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "lane", "automatic_lane", "reasons", "policy_version", "threshold_minutes"],
  "properties": {
    "schema": {"const": "akashic.routing-decision/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lane": {"enum": ["fast", "durable"]},
    "automatic_lane": {"enum": ["fast", "durable"]},
    "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "threshold_minutes": {"type": "number", "exclusiveMinimum": 0}
  }
}
