{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashic.dev/schemas/v1/context-need.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "task_id", "logical_attempt_id", "expected_seq", "missing", "known_digests", "max_tokens"],
  "properties": {
    "schema": {"const": "akashic.context-need/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "logical_attempt_id": {"type": "string", "minLength": 1},
    "expected_seq": {"type": "integer", "minimum": 0},
    "missing": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_digests": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "max_tokens": {"type": "integer", "minimum": 1}
  }
}
