{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "akashic.verification-report/v1",
  "title": "VerificationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verification_id", "subject_digest", "decision", "verifier", "policy_version", "checks", "completed_at"],
  "properties": {
    "schema": {"const": "akashic.verification-report/v1"},
    "verification_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["check_id", "kind", "status", "required", "evidence_refs", "summary"],
        "properties": {"check_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "required": {"type": "boolean"}, "evidence_refs": {"type": "array", "items": {"$ref": "akashic.artifact-ref/v1"}}, "summary": {"type": ["string", "null"]}}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
