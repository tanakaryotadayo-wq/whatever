{
  "name": "akashic-agent-operating-layer",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "workflows/*",
    "apps/*",
    "deploy/vercel-chatgpt-app"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "doctor": "node scripts/doctor.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:gateway": "npm run build -w akashic-chatgpt-gateway",
    "test:schemas": "node scripts/validate-schemas.mjs",
    "test:knowledge": "node scripts/validate-knowledge-packets.mjs && node scripts/validate-external-adoption-policy.mjs && npm --prefix experiments/orchestrator-bakeoff test",
    "test:core": "npm run test --workspaces --if-present",
    "test:gateway": "npm run test -w akashic-chatgpt-gateway",
    "test:cloudflare": "npm --prefix deploy/cloudflare-kernel test",
    "test": "npm run doctor && npm run test:schemas && npm run test:knowledge && npm run test:core && npm run test:cloudflare",
    "test:p0": "npm run test:integration -w @akashic/temporal-workflow",
    "test:codex-live": "bash scripts/codex-live-acceptance.sh",
    "test:drive-live": "npm run test:live -w @akashic/drive-adapter"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.0"
    },
    "@workflow/world-vercel": {
      "undici": "7.29.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
