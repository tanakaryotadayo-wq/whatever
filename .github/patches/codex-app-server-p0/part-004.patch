+import { EventCollector } from "./event-collector.js";
+import { CodexAppServerProcess } from "./process-manager.js";
+
+function codedError(code, message, details = {}) {
+  return Object.assign(new Error(message), { code, details });
+}
+
+function textInput(text) {
+  return { type: "text", text, textElements: [] };
+}
+
+function normalizeEffortOption(option) {
+  return option?.reasoningEffort ?? option?.reasoning_effort ?? option;
+}
+
+function modelName(model) {
+  return model?.model ?? model?.id ?? null;
+}
+
+function isTerminalStatus(status) {
+  return ["completed", "interrupted", "failed"].includes(String(status ?? "").toLowerCase());
+}
+
+export class CodexAppServerAdapter {
+  constructor({
+    processManager = null,
+    codexBin = "codex",
+    processArgs = ["app-server", "--stdio"],
+    processCwd = undefined,
+    processEnv = {},
+    clientInfo = {
+      name: "akashic_agent_operating_layer",
+      title: "Akashic Agent Operating Layer",
+      version: "0.10.0",
+    },
+    turnTimeoutMs = 600_000,
+    interruptGraceMs = 30_000,
+  } = {}) {
+    this.processManager = processManager ?? new CodexAppServerProcess({
+      command: codexBin,
+      args: processArgs,
+      cwd: processCwd,
+      env: processEnv,
+    });
+    this.clientInfo = clientInfo;
+    this.turnTimeoutMs = turnTimeoutMs;
+    this.interruptGraceMs = interruptGraceMs;
+    this.collector = null;
+    this.initializeResult = null;
+    this.models = [];
+    this.serverRequestViolations = [];
+    this.started = false;
+  }
+
+  get transport() {
+    if (!this.processManager.transport) throw codedError("NOT_STARTED", "adapter is not started");
+    return this.processManager.transport;
+  }
+
+  async start() {
+    if (this.started) return this;
+    await this.processManager.start();
+    this.collector = new EventCollector(this.transport);
+    this.transport.on("serverRequest", (request) => {
+      const violation = {
+        at: new Date().toISOString(),
+        id: request.id,
+        method: request.method,
+        params: request.params ?? {},
+      };
+      this.serverRequestViolations.push(violation);
+      this.transport.respondError(request.id, {
+        code: -32000,
+        message: "Akashic live certification denies all server-initiated approval and elicitation requests",
+        data: { failClosed: true, method: request.method },
+      });
+    });
+
+    this.initializeResult = await this.transport.request("initialize", {
+      clientInfo: this.clientInfo,
+      capabilities: { experimentalApi: false },
+    });
+    this.transport.notify("initialized");
+    this.models = await this.listModels();
+    this.started = true;
+    return this;
+  }
+
