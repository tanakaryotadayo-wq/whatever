+  const actualEvidenceRoot = resolve(evidenceRoot ?? join(root, "evidence", "codex-live-two-turn"));
+  await mkdir(actualEvidenceRoot, { recursive: true });
+
+  let codexVersion = codexVersionOverride;
+  let protocolManifest = protocolManifestOverride;
+  if (!skipBinaryPreparation) {
+    codexVersion = await discoverCodexVersion(codexBin);
+    const schemaRoot = resolve(generatedRoot ?? join(
+      root,
+      "packages",
+      "codex-app-server-adapter",
+      "generated",
+      safeVersionSegment(codexVersion),
+      "schema",
+    ));
+    await generateProtocolSchema({ codexBin, outDir: schemaRoot, cwd: root });
+    protocolManifest = await writeProtocolManifest({
+      root: schemaRoot,
+      codexVersion,
+      generationCommand: `${basename(codexBin)} app-server generate-json-schema --out ${relative(root, schemaRoot)}`,
+      sourceCommit,
+    });
+  }
+  if (!codexVersion || !protocolManifest?.protocol_schema_sha256) {
+    throw codedError("BINARY_PREPARATION_MISSING", "codex version and protocol manifest are required");
+  }
+
+  const adapter = adapterFactory
+    ? await adapterFactory()
+    : new CodexAppServerAdapter({ codexBin });
+  const aggregateStartedAt = new Date().toISOString();
+  const attempts = [];
+  try {
+    await adapter.start();
+    const selection = adapter.selectModel({ requestedModel, requestedEffort, requestedServiceTier });
+    for (let attempt = 1; attempt <= runs; attempt += 1) {
+      attempts.push(await certifyAttempt({
+        adapter,
+        attempt,
+        selection,
+        codexVersion,
+        protocolManifest,
+        fixtureRoot: actualFixtureRoot,
+        evidenceRoot: actualEvidenceRoot,
+        sourceCommit,
+      }));
+    }
+
+    const sameVersion = attempts.every((attempt) => attempt.manifest.codex_version === codexVersion);
+    const consecutivePasses = attempts.length === runs && attempts.every((attempt) => attempt.manifest.status === "PASS");
+    const receipt = {
+      schema: "akashic.codex-app-server-certification-receipt/v1",
+      status: sameVersion && consecutivePasses ? "CERTIFIED" : "FAILED",
+      source_commit: sourceCommit,
+      codex_version: codexVersion,
+      protocol_schema_sha256: protocolManifest.protocol_schema_sha256,
+      model: selection.model,
+      reasoning_effort: selection.effort,
+      service_tier: selection.service_tier,
+      required_consecutive_passes: runs,
+      observed_consecutive_passes: attempts.length,
+      same_codex_version: sameVersion,
+      all_passed: consecutivePasses,
+      run_refs: attempts.map((attempt) => ({
+        run_id: attempt.runId,
+        manifest: relative(actualEvidenceRoot, join(attempt.runEvidenceDir, "manifest.json")),
+        manifest_sha256: attempt.hashes["manifest.json"]?.sha256 ?? null,
+      })),
+      boundaries: {
+        proves: [
+          "official codex app-server JSONL stdio handshake",
+          "model/list validated selection",
+          "one thread/start and two turn/start calls per attempt",
+          "same-thread INPUT_REQUIRED to delta-only COMPLETED",
+          "turn/started and turn/completed authority",
+          "exact artifact bytes and digest",
+          "fail-closed approval and elicitation boundary",
+        ],
+        does_not_prove: [
+          "app-server restart and thread/resume",
+          "Temporal or Vercel production Activity integration",
+          "Google Drive artifact publication",
+          "multi-agent routing",
+        ],
+      },
+      started_at: aggregateStartedAt,
+      completed_at: new Date().toISOString(),
+    };
+    assertNoCredentialLeak(receipt);
+    await writeJson(join(actualEvidenceRoot, "certification-receipt.json"), receipt);
+    if (receipt.status !== "CERTIFIED") {
+      throw codedError("CERTIFICATION_INCOMPLETE", "required consecutive live passes were not achieved", { receipt });
+    }
+    return receipt;
+  } catch (error) {
+    const failure = sanitizeValue({
+      schema: "akashic.codex-app-server-certification-failure/v1",
+      status: "FAILED",
+      source_commit: sourceCommit,
+      codex_version: codexVersion,
+      protocol_schema_sha256: protocolManifest?.protocol_schema_sha256 ?? null,
+      completed_attempts: attempts.map((attempt) => attempt.runId),
+      error: {
+        code: error?.code ?? error?.name ?? "UNKNOWN",
+        message: error instanceof Error ? error.message : String(error),
+        details: error?.details ?? null,
+      },
+      started_at: aggregateStartedAt,
+      failed_at: new Date().toISOString(),
+    });
+    assertNoCredentialLeak(failure);
+    await writeJson(join(actualEvidenceRoot, "certification-failure.json"), failure);
+    throw error;
+  } finally {
+    await adapter.stop().catch(() => {});
+  }
+}
