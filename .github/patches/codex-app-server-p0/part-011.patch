+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { CodexAppServerAdapter } from "../src/client.js";
+import { runLiveTwoTurnCertification } from "../src/certify.js";
+import { CodexAppServerProcess } from "../src/process-manager.js";
+
+const packageRoot = resolve(fileURLToPath(new URL("..", import.meta.url)));
+const repoRoot = resolve(packageRoot, "../..");
+const mockServer = fileURLToPath(new URL("./fixtures/mock-app-server.mjs", import.meta.url));
+
+function makeAdapter(env = {}) {
+  return new CodexAppServerAdapter({
+    processManager: new CodexAppServerProcess({
+      command: process.execPath,
+      args: [mockServer],
+      env,
+    }),
+    turnTimeoutMs: 5_000,
+    interruptGraceMs: 1_000,
+  });
+}
+
+test("three consecutive fixture attempts use one thread and two turns each", async () => {
+  const evidenceRoot = await mkdtemp(join(tmpdir(), "akashic-codex-evidence-"));
+  try {
+    const receipt = await runLiveTwoTurnCertification({
+      repoRoot,
+      runs: 3,
+      evidenceRoot,
+      skipBinaryPreparation: true,
+      codexVersionOverride: "mock-codex 0.10.0",
+      protocolManifestOverride: { protocol_schema_sha256: `sha256:${"a".repeat(64)}` },
+      sourceCommit: "fixture",
+      adapterFactory: async () => makeAdapter(),
+    });
+    assert.equal(receipt.status, "CERTIFIED");
+    assert.equal(receipt.observed_consecutive_passes, 3);
+    for (const ref of receipt.run_refs) {
+      const manifest = JSON.parse(await readFile(join(evidenceRoot, ref.manifest), "utf8"));
+      assert.equal(manifest.thread_start_count, 1);
+      assert.equal(manifest.turn_start_count, 2);
+      assert.equal(manifest.turn_1_outcome, "INPUT_REQUIRED");
+      assert.equal(manifest.turn_2_outcome, "COMPLETED");
+      assert.equal(manifest.task_capsule_resent_on_turn_2, false);
+      assert.equal(manifest.checks.exact_result_bytes, true);
+    }
+  } finally {
+    await rm(evidenceRoot, { recursive: true, force: true });
+  }
+});
+
+test("server-initiated approval or elicitation fails closed", async () => {
+  const client = makeAdapter({ MOCK_SERVER_REQUEST: "1" });
+  const workspace = await mkdtemp(join(tmpdir(), "akashic-codex-fail-closed-"));
+  try {
+    await client.start();
+    const selection = client.selectModel();
+    const { thread } = await client.startThread({ workspace, selection });
+    await assert.rejects(
+      client.runTurn({
+        threadId: thread.id,
+        inputText: "request approval",
+        outputSchema: { type: "object" },
+        selection,
+        timeoutMs: 300,
+      }),
+      (error) => ["NOTIFICATION_TIMEOUT", "TURN_TIMEOUT_INTERRUPTED", "SERVER_REQUEST_FAIL_CLOSED"].includes(error.code),
+    );
+    assert.equal(client.serverRequestViolations.length, 1);
+  } finally {
+    await client.stop();
+    await rm(workspace, { recursive: true, force: true });
+  }
+});
