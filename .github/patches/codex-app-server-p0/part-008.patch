+++ b/packages/codex-app-server-adapter/src/protocol-schema.js
@@ -0,0 +1,78 @@
+import { createHash } from "node:crypto";
+import { readdir, readFile, writeFile } from "node:fs/promises";
+import { join, relative } from "node:path";
+
+async function filesUnder(root, current = root) {
+  const entries = await readdir(current, { withFileTypes: true });
+  const files = [];
+  for (const entry of entries) {
+    const absolute = join(current, entry.name);
+    if (entry.isDirectory()) files.push(...await filesUnder(root, absolute));
+    else if (entry.isFile()) files.push(absolute);
+  }
+  return files.sort((a, b) => relative(root, a).localeCompare(relative(root, b)));
+}
+
+export function safeVersionSegment(version) {
+  return version.trim().replace(/[^A-Za-z0-9._-]+/g, "_").replace(/^_+|_+$/g, "") || "unknown";
+}
+
+export async function digestProtocolSchema(root) {
+  const hash = createHash("sha256");
+  const files = await filesUnder(root);
+  for (const path of files) {
+    const rel = relative(root, path).split("\\").join("/");
+    if (rel === "manifest.json") continue;
+    const bytes = await readFile(path);
+    hash.update(rel);
+    hash.update("\0");
+    hash.update(bytes);
+    hash.update("\0");
+  }
+  return { digest: `sha256:${hash.digest("hex")}`, files: files.map((path) => relative(root, path).split("\\").join("/")) };
+}
+
+export async function assertRequiredProtocolSurface(root) {
+  const files = await filesUnder(root);
+  const texts = [];
+  for (const path of files) {
+    if (path.endsWith(".json")) texts.push(await readFile(path, "utf8"));
+  }
+  const corpus = texts.join("\n");
+  const required = [
+    '"initialize"',
+    '"initialized"',
+    '"model/list"',
+    '"thread/start"',
+    '"turn/start"',
+    '"turn/interrupt"',
+    '"outputSchema"',
+    '"supportedReasoningEfforts"',
+  ];
+  const missing = required.filter((token) => !corpus.includes(token));
+  if (missing.length > 0) {
+    throw Object.assign(new Error(`generated protocol schema lacks required stable surface: ${missing.join(", ")}`), {
+      code: "PROTOCOL_SCHEMA_INCOMPATIBLE",
+      details: { missing },
+    });
+  }
+  return { required, missing: [] };
+}
+
+export async function writeProtocolManifest({ root, codexVersion, generationCommand, sourceCommit = null }) {
+  const surface = await assertRequiredProtocolSurface(root);
+  const { digest, files } = await digestProtocolSchema(root);
+  const manifest = {
+    schema: "akashic.codex-protocol-schema-manifest/v1",
+    codex_version: codexVersion,
+    protocol_schema_sha256: digest,
+    generation_command: generationCommand,
+    generated_at: new Date().toISOString(),
+    source_commit: sourceCommit,
+    file_count: files.filter((file) => file !== "manifest.json").length,
+    files: files.filter((file) => file !== "manifest.json"),
+    required_surface: surface.required,
+  };
+  await writeFile(join(root, "manifest.json"), `${JSON.stringify(manifest, null, 2)}\n`, "utf8");
+  return manifest;
+}
