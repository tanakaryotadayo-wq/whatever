diff --git a/packages/codex-app-server-adapter/test/protocol.test.mjs b/packages/codex-app-server-adapter/test/protocol.test.mjs
new file mode 100644
index 0000000..87154d5
--- /dev/null
+++ b/packages/codex-app-server-adapter/test/protocol.test.mjs
@@ -0,0 +1,54 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { fileURLToPath } from "node:url";
+import { CodexAppServerAdapter } from "../src/client.js";
+import { CodexAppServerProcess } from "../src/process-manager.js";
+
+const mockServer = fileURLToPath(new URL("./fixtures/mock-app-server.mjs", import.meta.url));
+
+function adapter(env = {}) {
+  return new CodexAppServerAdapter({
+    processManager: new CodexAppServerProcess({
+      command: process.execPath,
+      args: [mockServer],
+      env,
+    }),
+    turnTimeoutMs: 5_000,
+  });
+}
+
+test("initialize precedes initialized and model/list without experimental opt-in", async () => {
+  const client = adapter();
+  try {
+    await client.start();
+    const outbound = client.transport.trace.filter((entry) => entry.direction === "outbound");
+    assert.equal(outbound[0].message.method, "initialize");
+    assert.equal(outbound[0].message.params.capabilities.experimentalApi, false);
+    assert.equal(outbound[1].message.method, "initialized");
+    assert.equal(outbound[2].message.method, "model/list");
+    assert.equal(client.models.length, 1);
+  } finally {
+    await client.stop();
+  }
+});
+
+test("model/list overload is retried and selection validates effort and tier", async () => {
+  const client = adapter({ MOCK_OVERLOAD_MODEL_LIST: "1" });
+  try {
+    await client.start();
+    const selection = client.selectModel({ requestedEffort: "high", requestedServiceTier: "standard" });
+    assert.equal(selection.model, "mock-model");
+    assert.equal(selection.effort, "high");
+    assert.equal(selection.service_tier, "standard");
+    const modelListRequests = client.transport.trace.filter(
+      (entry) => entry.direction === "outbound" && entry.message?.method === "model/list",
+    );
+    assert.equal(modelListRequests.length, 2);
+    assert.throws(
+      () => client.selectModel({ requestedEffort: "ultra" }),
+      (error) => error.code === "EFFORT_UNAVAILABLE",
+    );
+  } finally {
+    await client.stop();
+  }
+});
