+          { reasoningEffort: "medium", description: "medium" },
+          { reasoningEffort: "high", description: "high" },
+        ],
+        defaultReasoningEffort: "medium",
+        serviceTiers: [{ id: "standard", name: "Standard", description: "mock" }],
+        defaultServiceTier: "standard",
+        isDefault: true,
+      }],
+      nextCursor: null,
+    });
+    return;
+  }
+  if (message.method === "thread/start") {
+    threadCounter += 1;
+    const threadId = `thread-${threadCounter}`;
+    const thread = {
+      id: threadId,
+      preview: "",
+      modelProvider: "mock",
+      createdAt: Math.floor(Date.now() / 1000),
+      updatedAt: Math.floor(Date.now() / 1000),
+      status: { type: "idle" },
+      path: null,
+      cwd: message.params.cwd,
+      ephemeral: true,
+      turns: [],
+    };
+    threads.set(threadId, { cwd: message.params.cwd, turns: [] });
+    respond(message.id, {
+      thread,
+      model: message.params.model ?? "mock-model",
+      modelProvider: "mock",
+      serviceTier: message.params.serviceTier ?? "standard",
+      cwd: message.params.cwd,
+      instructionSources: [],
+      approvalPolicy: "never",
+      approvalsReviewer: "user",
+      sandbox: { type: "workspaceWrite" },
+      reasoningEffort: "medium",
+    });
+    send({ method: "thread/started", params: { thread } });
+    return;
+  }
+  if (message.method === "turn/start") {
+    const threadId = message.params.threadId;
+    const state = threads.get(threadId);
+    if (!state) {
+      respondError(message.id, -32004, "thread not found");
+      return;
+    }
+    turnCounter += 1;
+    const turnId = `turn-${turnCounter}`;
+    state.turns.push(turnId);
+    const turn = { id: turnId, status: "inProgress", items: [], error: null };
+    respond(message.id, { turn });
+    send({ method: "turn/started", params: { threadId, turn } });
+
+    if (process.env.MOCK_SERVER_REQUEST === "1") {
+      send({ id: 9000 + turnCounter, method: "item/commandExecution/requestApproval", params: { threadId, turnId } });
+      return;
+    }
+
+    const text = inputText(message.params);
+    if (state.turns.length === 1) {
+      const taskId = taskField(text, "task_id");
+      const logicalAttemptId = taskField(text, "logical_attempt_id");
+      completedItem(threadId, turnId, {
+        outcome: "INPUT_REQUIRED",
+        context_need: {
+          request_id: `need:${taskId}:required_value`,
+          task_id: taskId,
+          logical_attempt_id: logicalAttemptId,
+          expected_seq: 0,
+          missing: ["required_value"],
+          known_digests: [],
+          max_tokens: 256,
+        },
+        compact_result: null,
+        artifact_paths: [],
+        evidence: ["required_value missing"],
+      });
+      return;
+    }
+
+    const required = text.match(/"required_value"\s*:\s*"((?:\\.|[^"\\])*)"/)?.[1];
+    const requiredValue = required === undefined ? null : JSON.parse(`"${required}"`);
+    if (requiredValue === null) {
+      completedItem(threadId, turnId, {
+        outcome: "FAILED",
+        context_need: null,
+        compact_result: "delta missing required_value",
+        artifact_paths: [],
+        evidence: [],
+      });
+      return;
+    }
+    await writeFile(join(state.cwd, "result.txt"), requiredValue, "utf8");
+    completedItem(threadId, turnId, {
+      outcome: "COMPLETED",
+      context_need: null,
+      compact_result: "result.txt created from ContextPacketDelta",
+      artifact_paths: ["result.txt"],
+      evidence: ["exact bytes written"],
+    });
+    return;
+  }
+  if (message.method === "turn/interrupt") {
+    respond(message.id, {});
+    send({
+      method: "turn/completed",
+      params: {
+        threadId: message.params.threadId,
+        turn: { id: message.params.turnId, status: "interrupted", items: [], error: null },
+      },
+    });
+    return;
+  }
+  if (Object.hasOwn(message, "id")) respondError(message.id, -32601, `method not found: ${message.method}`);
+}
+
+rl.on("line", (line) => {
+  if (!line.trim()) return;
+  let message;
+  try {
+    message = JSON.parse(line);
+  } catch {
+    process.exitCode = 2;
+    return;
+  }
+  handle(message).catch((error) => {
+    if (Object.hasOwn(message, "id")) respondError(message.id, -32099, error.message);
+  });
+});
