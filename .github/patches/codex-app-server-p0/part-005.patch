+    const events = this.collector.snapshot(eventStartIndex);
+    return {
+      threadId,
+      turnId,
+      params,
+      response,
+      started,
+      completed,
+      events,
+      eventCounts: this.collector.counts(events),
+      trace: this.transport.snapshotTrace(traceStartIndex),
